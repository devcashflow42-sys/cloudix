# ==============================================================
#  Variables SECRETAS para desarrollo local con `wrangler pages dev`.
#  Copia este archivo a `.dev.vars` (NO lo subas al repo).
#
#  En producción, define cada una con:
#    wrangler pages secret put DATABASE_URL
#    wrangler pages secret put JWT_SECRET
#    wrangler pages secret put CRON_SECRET
# ==============================================================

# Cadena de conexión de Neon (PostgreSQL serverless sobre HTTP/WS).
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Clave para firmar JWT (HS256). Usa una cadena aleatoria de >= 32 chars.
JWT_SECRET="cambia-esto-por-una-clave-larga-y-aleatoria-de-32-o-mas"

# Secreto para la tarea de limpieza de historias (POST /stories/cleanup).
# Debe coincidir con el que use el planificador (GitHub Actions / cron).
CRON_SECRET="otra-cadena-aleatoria-para-el-cron-de-limpieza"

# --------------------------------------------------------------
# Opcional: URL pública del bucket R2 usado por /upload.
# Si se define, la respuesta de /upload incluye la URL final del archivo.
# (Requiere descomentar el binding MEDIA_BUCKET en wrangler.toml.)
# --------------------------------------------------------------
# MEDIA_PUBLIC_URL="https://media.tudominio.com"

# Las variables NO secretas (APP_NAME, JWT_ISSUER, ACCESS_TOKEN_TTL, CORS_ORIGIN...)
# están en wrangler.toml -> [vars]. Ver la sección "Variables de entorno" del README.
