# ==============================================================
#  Cloudix — Secretos para DESARROLLO LOCAL
# --------------------------------------------------------------
#  1. Copia este archivo:   cp .dev.vars.example .dev.vars
#  2. Rellena los valores.  `.dev.vars` está en .gitignore: NUNCA lo subas.
#  3. Lo leen `npm run dev` (wrangler pages dev) y `npm run migrate`.
#
#  En PRODUCCIÓN no se usa este archivo. Define cada secreto con:
#    npx wrangler pages secret put DATABASE_URL
#    npx wrangler pages secret put JWT_SECRET
#    npx wrangler pages secret put CRON_SECRET
#  o en Cloudflare: Workers & Pages → tu proyecto → Settings → Variables and Secrets.
#  Usa valores DISTINTOS en desarrollo y producción.
#
#  Guía completa: sección "Variables de entorno" del README.
# ==============================================================

# --- OBLIGATORIO ----------------------------------------------
# Cadena de conexión de Neon (usa la variante "-pooler").
# Neon → Dashboard → Connection Details → Pooled connection.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Clave para firmar los JWT (HS256). Mínimo 32 caracteres aleatorios.
# Genérala con:  openssl rand -base64 48
JWT_SECRET="cambia-esto-por-una-clave-larga-y-aleatoria-de-32-o-mas"

# --- RECOMENDADO ----------------------------------------------
# Protege POST /stories/cleanup (limpieza de historias caducadas).
# Debe coincidir con el secreto STORIES_CRON_SECRET de GitHub Actions.
# Genérala con:  openssl rand -hex 32
CRON_SECRET="otra-cadena-aleatoria-para-el-cron-de-limpieza"

# --- SOLO DESARROLLO ------------------------------------------
# Si vale "true", /auth/register y /auth/forgot-password devuelven el token
# de verificación/restablecimiento para probar sin servidor de correo.
# NUNCA lo actives en producción: permitiría restablecer cualquier contraseña.
# EXPOSE_DEV_TOKENS="true"

# --- OPCIONAL: archivos en R2 ---------------------------------
# URL pública del bucket usado por /upload. Requiere descomentar el
# binding [[r2_buckets]] (MEDIA_BUCKET) en wrangler.toml.
# MEDIA_PUBLIC_URL="https://media.tudominio.com"

# Las variables NO secretas (APP_NAME, JWT_ISSUER, ACCESS_TOKEN_TTL,
# CORS_ORIGIN...) se configuran en wrangler.toml → [vars].
