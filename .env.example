NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1
APP_NAME=Nubifly API
APP_URL=http://localhost:3000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=dataset
DB_USER=postgres
DB_PASSWORD=changeme
DB_SSL=false

# Si usas Neon, Supabase, Render u otro Postgres remoto, coloca aquí la URL completa
DATABASE_URL=

DB_POOL_MAX=20
DB_POOL_MIN=2
DB_POOL_IDLE_TIMEOUT=30000
DB_POOL_CONNECTION_TIMEOUT=5000

JWT_ACCESS_SECRET=change_me_access
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_refresh
JWT_REFRESH_EXPIRES_IN=30d
JWT_ISSUER=nubifly-api
JWT_AUDIENCE=nubifly-clients

BCRYPT_SALT_ROUNDS=12

CORS_ORIGIN=*
CORS_CREDENTIALS=true

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_UPLOAD_MAX=30

STORAGE_ROOT=src/storage
MAX_FILE_SIZE_IMAGE=10485760
MAX_FILE_SIZE_VIDEO=524288000
MAX_FILE_SIZE_AUDIO=104857600
MAX_FILE_SIZE_DOCUMENT=52428800
MAX_FILE_SIZE_PODCAST=209715200
MAX_FILE_SIZE_OTHER=104857600

LOG_LEVEL=info
LOG_DIR=src/logs
LOG_MAX_FILES=14d
LOG_MAX_SIZE=20m

CACHE_TTL_SECONDS=300
CACHE_CHECK_PERIOD=60

SEED_ADMIN_EMAIL=admin@nubifly.local
SEED_ADMIN_PASSWORD=Admin1234!
SEED_ADMIN_USERNAME=admin
