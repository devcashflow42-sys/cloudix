{
  "name": "cloudix-edge",
  "version": "1.0.0",
  "description": "Backend de red social sobre Cloudflare Pages Functions (edge) + PostgreSQL (Neon serverless). JWT, arquitectura modular.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "wrangler pages dev public --compatibility-date=2024-09-23",
    "deploy": "wrangler pages deploy public",
    "migrate": "node scripts/migrate.mjs",
    "tail": "wrangler pages deployment tail"
  },
  "keywords": [
    "cloudflare",
    "pages",
    "functions",
    "workers",
    "edge",
    "postgresql",
    "neon",
    "jwt",
    "rest-api",
    "social-network"
  ],
  "author": "David",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.4",
    "jose": "^5.9.6"
  },
  "devDependencies": {
    "pg": "^8.13.1",
    "wrangler": "^3.90.0"
  }
}
